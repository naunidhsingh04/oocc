# Copy to .env for local `docker compose up`. Nothing here is a real secret
# — Gemini API keys are bring-your-own, sent per-request as X-Provider-Key
# from localStorage (docs/PRD.md §4.5), and are never stored in an env file.

DATABASE_URL=postgresql://oocc:oocc@localhost:5432/oocc
REDIS_URL=redis://localhost:6379/0
EXECUTOR_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
