{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oocc.dev/schemas/viz-plan.schema.json",
  "title": "VizPlan",
  "description": "Panel plan emitted by the viz_planner agent node (PRD docs/PRD.md §4.3). Panel `type` must be a member of the hardcoded panel registry v1; hallucinated types must be validated against this schema and dropped before rendering. Append-only: see trace.schema.json header for the versioning policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout", "panels"],
  "properties": {
    "layout": {
      "type": "string",
      "description": "Named workspace layout, e.g. \"primary+stack\".",
      "minLength": 1
    },
    "panels": {
      "type": "array",
      "items": { "$ref": "#/$defs/Panel" }
    }
  },

  "$defs": {
    "PanelType": {
      "type": "string",
      "description": "Panel registry v1 (§4.3).",
      "enum": [
        "array",
        "array_2d",
        "linked_list",
        "binary_tree",
        "graph",
        "stack",
        "queue",
        "hash_map",
        "call_stack",
        "recursion_tree",
        "variables",
        "heap_objects",
        "console",
        "timeline"
      ]
    },

    "PanelRole": {
      "type": "string",
      "description": "Placement hint within `layout`, e.g. \"primary\" or \"secondary\".",
      "minLength": 1
    },

    "Binding": {
      "type": "string",
      "description": "What the panel is bound to: a heap ref (\"o1\"), a frame path (\"frame.lo\"), or another addressable trace location.",
      "minLength": 1
    },

    "Panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/PanelType" },
        "binding": { "$ref": "#/$defs/Binding" },
        "role": { "$ref": "#/$defs/PanelRole" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Annotation" }
        }
      }
    },

    "Annotation": {
      "description": "A panel decoration. \"pointer\" and \"window\" are the known kinds from §4.3's worked example; any other kind validates structurally as {kind, label?} plus free-form fields so the registry can grow without breaking older plans.",
      "oneOf": [
        { "$ref": "#/$defs/PointerAnnotation" },
        { "$ref": "#/$defs/WindowAnnotation" },
        { "$ref": "#/$defs/GenericAnnotation" }
      ]
    },

    "PointerAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "bind"],
      "properties": {
        "kind": { "const": "pointer" },
        "label": { "type": "string" },
        "bind": { "$ref": "#/$defs/Binding" }
      }
    },

    "WindowAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": { "const": "window" },
        "from": { "$ref": "#/$defs/Binding" },
        "to": { "$ref": "#/$defs/Binding" }
      }
    },

    "GenericAnnotation": {
      "type": "object",
      "description": "Forward-compatible fallback for annotation kinds not yet in the registry.",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "not": { "enum": ["pointer", "window"] }
        },
        "label": { "type": "string" }
      }
    }
  }
}
