# apps/api environment variables.
# Copy to .env for local use (docker-compose.yml sets most of these
# itself for local dev — this file is the reference for anywhere else,
# e.g. Render). Every value below is read via os.environ.get(...) with a
# localhost-shaped default meant only for local dev — see DEPLOY.md for
# which ones are load-bearing in production and what breaks without them.

# --- Required in production ---

# Set to "production" to enable the fail-loud startup checks in
# app/env_checks.py (refuses to start with a forgeable SESSION_SECRET or
# a wildcard/empty CORS_ORIGINS). Leave unset for local dev.
ENVIRONMENT=production

# Port this service listens on. Render sets this automatically — you
# normally don't need to set it yourself on Render.
PORT=8000

# Comma-separated list of exact origins allowed to call this API with
# credentials (cookies). Must be your deployed frontend's real origin(s)
# — never "*". Example: https://oocc.vercel.app
CORS_ORIGINS=

# Random secret used to sign session cookies and magic-link tokens
# (itsdangerous). Anyone who has this value can forge a valid login for
# any user — generate a real one, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Base URL of the executor service (services/executor). Internal/private
# network address if your platform supports it, otherwise its public URL.
EXECUTOR_URL=http://localhost:8001

# --- Optional: Postgres (accounts, problems, progress, RAG) ---
# Every Postgres-backed feature fails open when this is unset — the API
# still starts and POST /api/runs still works, you just don't get
# accounts/progress persistence or tutor RAG grounding. Migrations run
# automatically on container start (docker-entrypoint.sh) whenever this
# is set.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Optional: Redis (caching, rate limiting) ---
# Fails open when unset — caching is skipped and rate limiting doesn't
# limit anything (no crash either way).
REDIS_URL=redis://host:6379/0

# --- Optional: object storage for trace payloads (S3-compatible) ---
# Not currently wired into any request path (see DEPLOY.md) — reserved
# for when trace persistence lands. Leave unset for now.
TRACE_BUCKET=oocc-traces
# Set for Cloudflare R2 (R2's S3-compatible endpoint URL); leave unset
# for real AWS S3.
OOCC_S3_ENDPOINT_URL=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional: GitHub OAuth login ---
# Login-with-GitHub silently fails (invalid client) if left unset; every
# other auth path (magic link) is unaffected.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: magic-link email delivery ---
# When SMTP_HOST is unset, magic-link emails are recorded in memory
# instead of actually sent (fine for local dev, not for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@oocc.dev

# --- Optional: OpenTelemetry tracing ---
# With no endpoint set, spans are created and dropped — tracing is purely
# additive instrumentation, never required.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to "1" to print spans to stdout instead (only meaningful if
# OTEL_EXPORTER_OTLP_ENDPOINT is unset) — noisy, local debugging only.
OTEL_CONSOLE_EXPORT=
