# apps/web environment variables.
#
# NEXT_PUBLIC_* variables are inlined into the JS bundle at BUILD time,
# not read at request time — set this in your hosting platform's project
# settings (so it's present when the build runs), not just at runtime.
# See apps/web/lib/api/client.ts. Defaults to http://localhost:8000 when
# unset, which only works for local dev.
NEXT_PUBLIC_API_URL=https://your-api-host.example.com
