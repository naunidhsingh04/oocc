{
  "problemSlug": "binary-search",
  "correctSource": "def binary_search(arr, target):\n    lo, hi = 0, len(arr) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n\n\narr = [int(x) for x in input().split()]\ntarget = int(input())\n\nresult = binary_search(arr, target)\nprint(\"index:\", result)\n",
