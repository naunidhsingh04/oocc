{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "gen:contracts": {
      "inputs": ["trace.schema.json", "viz-plan.schema.json", "scripts/**"],
      "outputs": ["python/**", "ts/**"],
      "cache": false
    }
  }
}
